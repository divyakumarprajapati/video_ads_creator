# ── Application ─────────────────────────────────────────────
APP_NAME=video-ads-engine
APP_ENV=development
DEBUG=true
# Recommended defaults: keep logs quiet unless debugging
LOG_LEVEL=ERROR

# ── API ────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Auth ───────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
API_KEY_HEADER=X-API-Key

# ── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/video_ads
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/video_ads
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
# Extremely verbose SQL logging (disable unless debugging queries)
DATABASE_ECHO=false

# ── Feature Flags ──────────────────────────────────────────
# Set to "true" to enable Celery workers (requires Redis)
USE_CELERY=false
# Set to "true" to use Redis for progress tracking & rate limiting
REDIS_ENABLED=false
# "local" = filesystem storage (default), "s3" = S3-compatible
STORAGE_BACKEND=local

# ── Local Storage (used when STORAGE_BACKEND=local) ────────
LOCAL_STORAGE_ROOT=./output
LOCAL_STORAGE_URL_PREFIX=http://localhost:8000/static

# ── Redis (only when REDIS_ENABLED=true or USE_CELERY=true) ─
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── S3 Storage (only when STORAGE_BACKEND=s3) ──────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=video-ads
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000/video-ads

# ── OpenAI (ad-copy generation) ────────────────────────────
# Set your API key to enable AI-generated headlines, CTAs, secondary messages.
# When empty, the engine falls back to built-in template text.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1-chat-latest
OPENAI_MAX_TOKENS=512
OPENAI_TEMPERATURE=0.7
# Leave empty for default https://api.openai.com/v1
OPENAI_BASE_URL=

# ── AI Models (vision / video – open source) ──────────────
MODELS_DIR=/models
SDXL_MODEL_PATH=/models/stable-diffusion-xl-base-1.0
ANIMATEDIFF_MODEL_PATH=/models/animatediff-v3
SVD_MODEL_PATH=/models/stable-video-diffusion
REALESRGAN_MODEL_PATH=/models/realesrgan
REMBG_MODEL_PATH=/models/u2net
COMFYUI_API_URL=http://localhost:8188

# ── Video Processing ──────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_VIDEO_DURATION=60
DEFAULT_FPS=30
DEFAULT_CRF=23

# ── Worker Settings ────────────────────────────────────────
WORKER_CONCURRENCY=2
WORKER_MAX_RETRIES=2
WORKER_RETRY_DELAY=30
GPU_DEVICES=0

# ── Limits ─────────────────────────────────────────────────
MAX_PRODUCTS_PER_CAMPAIGN=500
MAX_IMAGE_SIZE_MB=10
MAX_CONCURRENT_CAMPAIGNS=10
RATE_LIMIT_PER_MINUTE=60
